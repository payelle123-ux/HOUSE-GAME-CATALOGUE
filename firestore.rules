rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: Readable by all visitors, writable for store management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings collection: Store info readable by all, writable for store management
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
