rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: Readable by all visitors, writable for store management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings collection: Store info readable by all, writable for store management
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Repair services collection
    match /repair_services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // Tournaments collection
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if true;
    }

    // Custom tabs collection
    match /custom_tabs/{tabId} {
      allow read: if true;
      allow write: if true;
    }

    // Home overview dynamic content
    match /home_content/{contentId} {
      allow read: if true;
      allow write: if true;
    }

    // Activities collection
    match /activities/{activityId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
