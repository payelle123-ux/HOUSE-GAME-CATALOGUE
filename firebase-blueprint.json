{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A gaming product in the House Game catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "badge": { "type": "string" },
        "inStock": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "specs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "category", "price", "description", "image", "inStock", "createdAt", "updatedAt"]
    },
    "ShopSettings": {
      "title": "ShopSettings",
      "description": "Store contact and general information for House Game",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slogan": { "type": "string" },
        "note": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "openingHours": { "type": "string" },
        "currency": { "type": "string" },
        "adminPin": { "type": "string" }
      },
      "required": ["name", "phone", "whatsapp", "address"]
    },
    "RepairService": {
      "title": "RepairService",
      "description": "Repair and workshop service item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "string" },
        "delay": { "type": "string" },
        "description": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "icon": { "type": "string" },
        "badge": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "price", "description"]
    },
    "GamingEvent": {
      "title": "GamingEvent",
      "description": "House Game event item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "entry": { "type": "string" },
        "status": { "type": "string" },
        "badge": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "date", "description"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Esport tournament at House Game",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "game": { "type": "string" },
        "cashPrize": { "type": "string" },
        "entryFee": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "maxSlots": { "type": "number" },
        "currentSlots": { "type": "number" },
        "platform": { "type": "string" },
        "format": { "type": "string" },
        "rules": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "game", "cashPrize", "date"]
    },
    "CustomTab": {
      "title": "CustomTab",
      "description": "User created custom tab with dynamic items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "icon": { "type": "string" },
        "description": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "slug"]
    },
    "HomeContent": {
      "title": "HomeContent",
      "description": "Customizable content for the home overview page",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "presentationText": { "type": "string" },
        "stats": { "type": "array", "items": { "type": "object" } },
        "values": { "type": "array", "items": { "type": "object" } },
        "bannerImage": { "type": "string" },
        "aboutText": { "type": "string" },
        "partners": { "type": "array", "items": { "type": "object" } },
        "socialLinks": { "type": "object" }
      },
      "required": ["heroTitle"]
    },
    "ActivityItem": {
      "title": "ActivityItem",
      "description": "Official House Game activities and services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "number" },
        "numberStr": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "badge": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "object" },
        "complementaryServices": { "type": "array", "items": { "type": "string" } },
        "iconName": { "type": "string" },
        "accentColor": { "type": "string" },
        "targetTab": { "type": "string" }
      },
      "required": ["id", "title", "description", "category"]
    },
    "ActivitiesBannerInfo": {
      "title": "ActivitiesBannerInfo",
      "description": "Customizable banner information for the Nos Activites tab",
      "type": "object",
      "properties": {
        "badge": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "locationTag": { "type": "string" },
        "countLabel": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["title"]
    },
    "EsportRegistration": {
      "title": "EsportRegistration",
      "description": "Tournament player registration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tournamentId": { "type": "string" },
        "tournamentTitle": { "type": "string" },
        "playerId": { "type": "string" },
        "fullName": { "type": "string" },
        "gamerTag": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "platform": { "type": "string" },
        "game": { "type": "string" },
        "status": { "type": "string" },
        "paymentConfirmed": { "type": "boolean" },
        "registeredAt": { "type": "number" }
      },
      "required": ["id", "tournamentId", "tournamentTitle", "fullName", "gamerTag", "phone", "status"]
    },
    "EsportLicense": {
      "title": "EsportLicense",
      "description": "Certified player license ID card",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "playerId": { "type": "string" },
        "gamerTag": { "type": "string" },
        "fullName": { "type": "string" },
        "status": { "type": "string" },
        "issuedAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "playerId", "gamerTag", "fullName", "status"]
    },
    "CompetitionRanking": {
      "title": "CompetitionRanking",
      "description": "Automatic performance-based ranking and results history per Esport competition and category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tournamentId": { "type": "string" },
        "tournamentTitle": { "type": "string" },
        "game": { "type": "string" },
        "gameCategory": { "type": "string" },
        "date": { "type": "string" },
        "cashPrizePool": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "publishedAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "notes": { "type": "string" },
        "scoringRule": { "type": "object" },
        "matchHistory": { "type": "array", "items": { "type": "object" } },
        "entries": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "tournamentId", "tournamentTitle", "isPublished", "updatedAt", "entries"]
    },
    "VenuePhoto": {
      "title": "VenuePhoto",
      "description": "Photo of the House Game gaming arena and rooms",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "imageUrl", "createdAt"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "House Game team member with photo, name, and role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "photoUrl": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "role", "createdAt"]
    },
    "AiConfig": {
      "title": "AiConfig",
      "description": "Global configuration for HOUSE GAME AI Assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "enabled": { "type": "boolean" },
        "assistantName": { "type": "string", "maxLength": 80 },
        "welcomeMessage": { "type": "string", "maxLength": 1000 },
        "personalityTone": { "type": "string" },
        "fallbackWhatsappMessage": { "type": "string", "maxLength": 500 },
        "whatsappGroupInviteUrl": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "enabled", "assistantName", "welcomeMessage", "updatedAt"]
    },
    "AiKnowledgeItem": {
      "title": "AiKnowledgeItem",
      "description": "Structured knowledge base entry used by HOUSE GAME AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 50 },
        "content": { "type": "string", "maxLength": 4000 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "title", "category", "content", "isActive", "createdAt", "updatedAt"]
    },
    "AiConversation": {
      "title": "AiConversation",
      "description": "Logged visitor or WhatsApp conversation with HOUSE GAME AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "visitorLabel": { "type": "string", "maxLength": 120 },
        "channel": { "type": "string", "enum": ["web", "whatsapp"] },
        "status": { "type": "string", "enum": ["active", "transferred", "resolved"] },
        "startedAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "messageCount": { "type": "number" },
        "hasUnanswered": { "type": "boolean" },
        "unansweredQuestions": { "type": "array", "items": { "type": "string" } },
        "transferredToWhatsappAt": { "type": "number" },
        "messages": { "type": "array", "items": { "type": "object" } },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "visitorLabel", "channel", "status", "startedAt", "updatedAt", "messages"]
    },
    "AiMarketingCampaign": {
      "title": "AiMarketingCampaign",
      "description": "AI-generated marketing or WhatsApp announcement campaign",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 180 },
        "channel": { "type": "string" },
        "objective": { "type": "string" },
        "tone": { "type": "string", "maxLength": 80 },
        "content": { "type": "string", "maxLength": 5000 },
        "hashtags": { "type": "array", "items": { "type": "string" } },
        "linkedEntityLabel": { "type": "string", "maxLength": 180 },
        "status": { "type": "string", "enum": ["draft", "approved", "rejected", "scheduled", "published"] },
        "scheduledFor": { "type": "string", "maxLength": 80 },
        "publishedAt": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 120 },
        "approvedBy": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "title", "channel", "content", "status", "createdAt", "updatedAt"]
    },
    "AiAdminRoleAssignment": {
      "title": "AiAdminRoleAssignment",
      "description": "Role-based access control assignment for HOUSE GAME AI CENTER",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "maxLength": 180 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["super_admin", "ai_editor", "marketing_manager", "viewer"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "email", "displayName", "role", "active", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "entity": "Product",
      "description": "Catalog products for House Game"
    },
    "/settings/{settingId}": {
      "entity": "ShopSettings",
      "description": "Store settings document"
    },
    "/repair_services/{serviceId}": {
      "entity": "RepairService",
      "description": "Repair and diagnosis workshop services"
    },
    "/events/{eventId}": {
      "entity": "GamingEvent",
      "description": "Gaming and launch events"
    },
    "/tournaments/{tournamentId}": {
      "entity": "Tournament",
      "description": "Esport official tournaments"
    },
    "/custom_tabs/{tabId}": {
      "entity": "CustomTab",
      "description": "Custom user-created navigation tabs"
    },
    "/home_content/{contentId}": {
      "entity": "HomeContent",
      "description": "Overview page dynamic content"
    },
    "/activities/{activityId}": {
      "entity": "ActivityItem",
      "description": "Activities items list"
    },
    "/registrations/{registrationId}": {
      "entity": "EsportRegistration",
      "description": "Player tournament registrations"
    },
    "/player_licenses/{licenseId}": {
      "entity": "EsportLicense",
      "description": "Player certified esport licenses"
    },
    "/rankings/{rankingId}": {
      "entity": "CompetitionRanking",
      "description": "Manual competition final rankings & podiums"
    },
    "/venue_photos/{photoId}": {
      "entity": "VenuePhoto",
      "description": "Photos of the House Game venue and gaming rooms"
    },
    "/team_members/{memberId}": {
      "entity": "TeamMember",
      "description": "Team members displayed in Qui sommes-nous"
    },
    "/ai_config/{configId}": {
      "entity": "AiConfig",
      "description": "HOUSE GAME AI Assistant global configuration"
    },
    "/ai_knowledge/{itemId}": {
      "entity": "AiKnowledgeItem",
      "description": "Centralized AI knowledge base entries"
    },
    "/ai_conversations/{conversationId}": {
      "entity": "AiConversation",
      "description": "Visitor and WhatsApp conversation logs"
    },
    "/ai_marketing_campaigns/{campaignId}": {
      "entity": "AiMarketingCampaign",
      "description": "AI marketing and WhatsApp announcement drafts & campaigns"
    },
    "/ai_roles/{roleId}": {
      "entity": "AiAdminRoleAssignment",
      "description": "Admin role permissions for HOUSE GAME AI CENTER"
    }
  }
}
